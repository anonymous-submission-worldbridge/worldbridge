# Native whole-home configuration for the indoor3+ visualization batch.
#
# The reduced floor-plan mode still requires at least one bedroom, living
# room, kitchen, and bathroom.  All furnishing remains the stock Infinigen
# constraint solver and procedural asset factories.
FloorPlanSolver.n_divide_trials = 25
FloorPlanSolver.iters_mult = 25
home_room_constraints.has_fewer_rooms = True

solve_objects.addition_weight_scalar = 3.0
compose_indoors.solve_steps_large = 60
compose_indoors.solve_steps_medium = 28
compose_indoors.solve_steps_small = 8

# This batch is indoor-only.  Skipping terrain and the native random camera
# search saves temporary disk and CPU; dedicated room-aware cameras are added
# only while rendering and are not baked into the source scene.
compose_indoors.terrain_enabled = False
compose_indoors.nature_backdrop_enabled = False
compose_indoors.pose_cameras_enabled = False
compose_indoors.animate_cameras_enabled = False
compose_indoors.floating_objs_enabled = False

# Keep ceilings and every room visible, and always retain native fixtures.
compose_indoors.invisible_room_ceilings_enabled = False
compose_indoors.hide_other_rooms_enabled = False
compose_indoors.lights_off_chance = 0.0

# Preserve furniture silhouettes while avoiding very large sub-millimetre
# meshes that are unnecessary for room-scale views.
target_face_size.global_clip_min = 0.02

