# Production-quality native Indoor solve for the all45_09 showcase residence.
# All furniture and display objects are generated by the real compose_indoors
# factories and constraint solver; these values only allocate a larger search
# budget to the existing large/medium/small placement stages.
compose_indoors.solve_steps_large = 45
compose_indoors.solve_steps_medium = 28
compose_indoors.solve_steps_small = 10
compose_indoors.terrain_enabled = False
target_face_size.global_clip_min = 0.02
